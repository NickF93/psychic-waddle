API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
PUBLIC_HTTP_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=18080
PUBLIC_HTTPS_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTPS_PORT=18443
PUBLIC_SERVER_NAME=vps.madnick.ovh
LETSENCRYPT_EMAIL=replace-with-letsencrypt-email

POSTGRES_DB=portfolio_rag_assistant
POSTGRES_USER=portfolio_rag_assistant
POSTGRES_PASSWORD=replace-with-local-password

CHAT_BACKEND=openai-compatible
CHAT_BASE_URL=https://example.invalid/v1
# Empty is valid for an anonymous OpenAI-compatible endpoint.
CHAT_API_KEY=
CHAT_MODEL=replace-with-chat-model
CHAT_TIMEOUT_SECONDS=15
CHAT_MAX_TOKENS=4096
# Empty selects the packaged profiles; set an absolute path for an operator file.
GENERATION_PROFILES_PATH=
# Choose a profile matching the selected target's actual advertised capabilities.
CHAT_PARAMETER_PROFILE=portfolio-primary
CHAT_REASONING_MODE=on
CHAT_REASONING_EFFORT=low
CHAT_TEMPERATURE=
CHAT_TOP_P=
CHAT_INPUT_MAX_BYTES=65536
CHAT_CONTEXT_TOKENS=1000000
CHAT_INPUT_TOKENIZER=
CHAT_REQUEST_TIMEOUT_SECONDS=240

# Leave all fallback identity fields empty to disable fallback.
CHAT_FALLBACK_BACKEND=ollama
CHAT_FALLBACK_BASE_URL=http://ollama:11434/api
CHAT_FALLBACK_MODEL=qwen2.5:3b-instruct
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_TIMEOUT_SECONDS=180
CHAT_FALLBACK_MAX_TOKENS=384
CHAT_FALLBACK_PARAMETER_PROFILE=portfolio-local
CHAT_FALLBACK_REASONING_MODE=default
CHAT_FALLBACK_REASONING_EFFORT=
CHAT_FALLBACK_TEMPERATURE=0
CHAT_FALLBACK_TOP_P=
CHAT_FALLBACK_INPUT_MAX_BYTES=65536
CHAT_FALLBACK_CONTEXT_TOKENS=4096
CHAT_FALLBACK_INPUT_TOKENIZER=/opt/tokenizers/qwen-tokenizer.json

EMBEDDING_BACKEND=openai-compatible
EMBEDDING_BASE_URL=https://example.invalid/v1
EMBEDDING_API_KEY=replace-with-embedding-provider-token
EMBEDDING_MODEL=replace-with-embedding-model

RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_FAN_OUT=50
RETRIEVAL_MIN_SCORE=0.3
INTENT_PROFILES_PATH=config/intent-profiles.json
QUESTION_COLLECTION_ENABLED=false

OLLAMA_KEEP_ALIVE=-1

LLAMA_CPP_MODEL_DIR=./models
LLAMA_CPP_CHAT_MODEL_PATH=/models/replace-with-chat-model.gguf
LLAMA_CPP_EMBEDDING_MODEL_PATH=/models/replace-with-embedding-model.gguf
LLAMA_CPP_EMBEDDING_POOLING=mean
